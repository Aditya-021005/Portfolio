---
import Icon from './Icon.astro';
import ProjectVisual from './ProjectVisual.astro';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
  /** Wide, editorial treatment used on the home page */
  featured?: boolean;
  index?: number;
}

const { project, featured = false, index = 0 } = Astro.props;
const { data, id } = project;
const href = `/projects/${id}`;
const num = String(index + 1).padStart(2, '0');
---

<article
  class:list={[
    'press-soft group relative',
    featured && 'lg:grid lg:grid-cols-12 lg:items-center lg:gap-x-14',
  ]}
  data-reveal
  data-category={data.category}
  style={`--reveal-delay:${Math.min(index, 4) * 60}ms`}
>
  <a href={href} class="absolute inset-0 z-20" aria-label={`Open ${data.title}`}></a>

  <!-- Visual -->
  <div
    class:list={[
      'scroll-rise press-soft relative overflow-hidden rounded-[var(--radius-card)] border border-[var(--line)] transition-colors duration-500 group-hover:border-[var(--line-strong)]',
      featured && 'lg:col-span-7 lg:order-last',
    ]}
  >
    <ProjectVisual
      cover={data.cover}
      title={data.title}
      slug={id}
      category={data.category}
      accent={data.accent}
      hero={featured}
      loading={index < 2 ? 'eager' : 'lazy'}
      class={featured ? 'aspect-[16/10]' : 'aspect-[4/3]'}
    />

    {
      data.series && (
        <span class="pointer-events-none absolute right-3 top-3 chip bg-void/70 backdrop-blur-sm">
          Part {String(data.series.part).padStart(2, '0')}
        </span>
      )
    }
  </div>

  <!-- Copy -->
  <div class:list={[featured ? 'mt-7 lg:col-span-5 lg:mt-0' : 'mt-5']}>
    <div class="flex items-center gap-3">
      <span class="label text-cyan-dim">{num}</span>
      <span class="h-px w-6 bg-[var(--line-strong)]"></span>
      <span class="label truncate">{data.category}</span>
    </div>

    <h3
      class:list={[
        'display mt-3.5 transition-colors duration-400 group-hover:text-cyan-soft',
        featured ? 'text-[1.75rem] sm:text-4xl' : 'text-lg sm:text-xl',
      ]}
    >
      {data.title}
    </h3>

    {
      data.tagline && featured && (
        <p class="mt-3 font-mono text-[0.8rem] text-cyan-soft/70">{data.tagline}</p>
      )
    }

    <p
      class:list={[
        'mt-3.5 leading-relaxed text-fg-muted',
        featured ? 'max-w-lg text-[1.0125rem]' : 'text-sm line-clamp-3',
      ]}
    >
      {data.summary}
    </p>

    {
      featured && data.highlights.length > 0 && (
        <dl class="mt-8 grid grid-cols-3 gap-x-4 border-t border-[var(--line)] pt-5">
          {data.highlights.slice(0, 3).map((h) => (
            <div>
              <dt class="display text-xl text-fg sm:text-2xl">{h.value}</dt>
              <dd class="label mt-1.5 block leading-snug">{h.label}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class="mt-5 flex flex-wrap gap-1.5">
      {data.tags.slice(0, featured ? 4 : 3).map((tag) => <span class="chip">{tag}</span>)}
      <span class="chip">{data.year}</span>
    </div>

    <span
      class="nudge mt-6 inline-flex items-center gap-2 text-sm text-fg-muted transition-colors duration-400 group-hover:text-fg"
    >
      Read the build
      <Icon name="arrowRight" class="size-4" />
    </span>
  </div>
</article>
