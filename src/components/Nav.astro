---
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';
const isActive = (href: string) => {
  const base = href.split('#')[0].replace(/\/$/, '') || '/';
  return base !== '/' && path.startsWith(base);
};
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500"
  style="height:var(--nav-h)"
>
  <div
    id="nav-surface"
    class:list={[
      'absolute inset-0 border-b transition-all duration-500',
      isHome ? 'border-white/0 bg-void/0 backdrop-blur-0' : 'border-[var(--line)] bg-void/70 backdrop-blur-md',
    ]}
  >
  </div>

  <nav class="shell relative flex h-full items-center justify-between gap-6">
    <a href="/" class="group flex items-center gap-3" aria-label={`${site.name} — home`}>
      <span
        class="grid size-8 shrink-0 place-items-center rounded border border-[var(--line-strong)] font-mono text-[0.65rem] tracking-widest text-fg transition-colors duration-500 group-hover:border-cyan-neon/70"
      >
        {site.initials}
      </span>
      <span class="hidden min-w-0 sm:block">
        <span class="block truncate text-sm font-medium leading-tight text-fg">{site.name}</span>
        <span class="label block truncate leading-tight">{site.role}</span>
      </span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'relative rounded-full px-4 py-2 text-sm transition-colors duration-300',
              isActive(item.href) ? 'text-fg' : 'text-fg-muted hover:text-fg',
            ]}
          >
            {item.label}
            {isActive(item.href) && (
              <span class="absolute inset-x-4 bottom-1 h-px bg-cyan-neon/70" />
            )}
          </a>
        ))
      }
      <a href={site.resume} class="btn btn-ghost ml-3 !px-4 !py-1.5 text-[0.8rem]" download>
        <Icon name="download" class="size-3.5" />
        Résumé
      </a>
    </div>

    <button
      id="nav-toggle"
      type="button"
      class="grid size-9 place-items-center rounded border border-[var(--line-strong)] text-fg transition-colors hover:border-cyan-neon/60 md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" class="size-5" />
    </button>
  </nav>
</header>

<!-- Mobile menu -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 translate-y-[-100%] opacity-0 transition-all duration-500 [transition-timing-function:var(--ease-out-expo)] md:hidden"
  aria-hidden="true"
>
  <div class="absolute inset-0 bg-void/92 backdrop-blur-2xl"></div>
  <div class="relative flex h-full flex-col justify-center px-8">
    <nav class="flex flex-col gap-1">
      {
        nav.map((item, i) => (
          <a
            href={item.href}
            class="group flex items-baseline justify-between border-b border-[var(--line)] py-5 text-3xl font-medium text-fg transition-colors hover:text-cyan-soft"
            style={`transition-delay:${i * 40}ms`}
          >
            <span class="display">{item.label}</span>
            <span class="font-mono text-xs text-fg-faint">0{i + 1}</span>
          </a>
        ))
      }
    </nav>
    <a href={site.resume} class="btn btn-primary mt-10 self-start" download>
      <Icon name="download" class="size-4" />
      Download résumé
    </a>
  </div>
</div>

<script is:inline>
  (() => {
    const initNav = () => {
      const surface = document.getElementById('nav-surface');
      const toggle = document.getElementById('nav-toggle');
      const menu = document.getElementById('mobile-menu');
      const isHome = window.location.pathname === '/';

      const onScroll = () => {
        const scrolled = window.scrollY > 18;
        if (!surface) return;

        surface.classList.toggle('bg-void/70', scrolled || !isHome);
        surface.classList.toggle('backdrop-blur-md', scrolled || !isHome);
        surface.classList.toggle('border-[var(--line)]', scrolled || !isHome);
        surface.classList.toggle('bg-void/0', !scrolled && isHome);
        surface.classList.toggle('backdrop-blur-0', !scrolled && isHome);
        surface.classList.toggle('shadow-[0_10px_30px_rgba(0,0,0,0.22)]', scrolled);
        surface.classList.toggle('shadow-none', !scrolled);
        surface.classList.toggle('border-white/0', !scrolled && isHome);
      };
      onScroll();
      window.removeEventListener('scroll', onScroll);
      window.addEventListener('scroll', onScroll, { passive: true });

      let open = false;
      const setMenu = (next) => {
        open = next;
        if (!menu || !toggle) return;
        menu.classList.toggle('translate-y-[-100%]', !open);
        menu.classList.toggle('opacity-0', !open);
        menu.classList.toggle('pointer-events-none', !open);
        menu.setAttribute('aria-hidden', String(!open));
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        document.body.style.overflow = open ? 'hidden' : '';
      };
      setMenu(false);

      toggle?.addEventListener('click', () => setMenu(!open));
      menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

      const onKeyDown = (e) => {
        if (e.key === 'Escape' && open) setMenu(false);
      };
      document.removeEventListener('keydown', onKeyDown);
      document.addEventListener('keydown', onKeyDown);
    };

    initNav();
    document.addEventListener('astro:page-load', initNav);
  })();
</script>
