---
import Icon from './Icon.astro';
import { site, socials, nav } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mt-28 border-t border-[var(--line)]">
  <div class="shell py-20">
    <!-- CTA -->
    <div class="flex flex-col items-start justify-between gap-10 lg:flex-row lg:items-end" data-reveal>
      <div class="max-w-2xl">
        <p class="eyebrow">Get in touch</p>
        <h2 class="display mt-5 text-[clamp(2rem,5vw,3.25rem)]">
          Building something that has to work in the field?
        </h2>
        <p class="mt-5 max-w-lg text-fg-muted">
          I'm open to roles and collaborations in embedded systems, robotics and UAV engineering.
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a href={`mailto:${site.email}`} class="btn btn-primary">
          <Icon name="mail" class="size-4" />
          Email me
        </a>
        <a href="/contact" class="nudge btn btn-ghost">
          Contact
          <Icon name="arrowRight" class="size-4" />
        </a>
      </div>
    </div>

    <div class="hairline my-14"></div>

    <!-- Columns -->
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3">
          <span
            class="grid size-9 place-items-center rounded-xl border border-[var(--line-strong)] bg-white/4 font-mono text-[0.7rem] tracking-widest text-cyan-soft"
          >
            {site.initials}
          </span>
          <div>
            <p class="text-sm font-medium">{site.name}</p>
            <p class="font-mono text-[0.62rem] uppercase tracking-[0.22em] text-fg-faint">
              {site.role}
            </p>
          </div>
        </div>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-fg-muted">
          {site.tagline}
        </p>
      </div>

      <nav aria-label="Footer">
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.22em] text-fg-faint">Navigate</p>
        <ul class="mt-4 space-y-2.5">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-fg-muted transition-colors hover:text-cyan-soft"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={site.resume}
              download
              class="text-sm text-fg-muted transition-colors hover:text-cyan-soft"
            >
              Résumé
            </a>
          </li>
        </ul>
      </nav>

      <div>
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.22em] text-fg-faint">Elsewhere</p>
        <ul class="mt-4 space-y-2.5">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target={s.href.startsWith('mailto:') ? undefined : '_blank'}
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-2.5 text-sm text-fg-muted transition-colors hover:text-cyan-soft"
                >
                  <Icon name={s.icon} class="size-4 text-fg-faint transition-colors group-hover:text-cyan-neon" />
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col-reverse items-start justify-between gap-4 border-t border-[var(--line)] pt-6 sm:flex-row sm:items-center"
    >
      <p class="font-mono text-[0.68rem] text-fg-faint">
        © {year} {site.name}. Built with Astro &amp; Tailwind.
      </p>
      <button
        type="button"
        id="to-top"
        class="group inline-flex items-center gap-2 font-mono text-[0.68rem] uppercase tracking-[0.18em] text-fg-faint transition-colors hover:text-cyan-soft"
      >
        Back to top
        <Icon name="arrowDown" class="size-3.5 rotate-180 transition-transform group-hover:-translate-y-0.5" />
      </button>
    </div>
  </div>
</footer>

<script is:inline>
  document.getElementById('to-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
