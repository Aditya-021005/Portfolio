---
interface Props {
  items: string[];
  /** seconds for one full loop */
  duration?: number;
  reverse?: boolean;
}

const { items, duration = 42, reverse = false } = Astro.props;
const doubled = [...items, ...items];
---

<div
  class="relative overflow-hidden border-y border-[var(--line)] py-5"
  style="mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)"
>
  <div
    class="anim-marquee flex w-max items-center gap-10"
    style={`animation-duration:${duration}s;animation-direction:${reverse ? 'reverse' : 'normal'}`}
  >
    {
      doubled.map((item, i) => (
        <span class="flex shrink-0 items-center gap-10">
          <span class="font-mono text-[0.78rem] uppercase tracking-[0.16em] text-fg-faint transition-colors hover:text-cyan-soft">
            {item}
          </span>
          {i < doubled.length - 1 && (
            <span class="size-1 shrink-0 rotate-45 bg-cyan-neon/40" aria-hidden="true" />
          )}
        </span>
      ))
    }
  </div>
</div>
