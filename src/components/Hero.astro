---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<section class="relative flex min-h-[92svh] flex-col justify-between pt-[var(--nav-h)]">
  <!-- ---------- Backdrop ----------
       Collage sits full-bleed behind the whole hero, desaturated + dimmed so
       it reads as texture rather than a photo. Grid pattern layers on top of
       it, same as before. -->
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <img
      src="/images/gallery.png"
      alt=""
      class="h-full w-full object-cover opacity-[0.28] grayscale-[0.15]"
    />
    <div class="absolute inset-0 bg-[#08090b]/70"></div>
    <div class="grid-backdrop absolute inset-0"></div>
  </div>

  <!-- ---------- Headline ---------- -->
  <div class="shell flex flex-1 items-center py-16 sm:py-20">
    <div class="w-full">
      <div class="grid gap-y-10 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-8 xl:col-span-7">
          <p class="eyebrow anim-fade-up">{site.role}</p>

          <h1
            class="display anim-fade-up mt-6 text-[clamp(2.5rem,9vw,5.75rem)] sm:mt-8"
            style="animation-delay:.06s"
          >
            {site.name}
          </h1>

          <p
            class="lede anim-fade-up mt-7 max-w-xl sm:mt-8"
            style="animation-delay:.12s"
          >
            Developing integrated electronics, power systems and physical hardware for autonomous
            robotic applications. Focused on practical motor control, sensor integration and rapid
            hardware prototyping.
          </p>

          <div class="anim-fade-up mt-9 flex flex-wrap gap-3 sm:mt-10" style="animation-delay:.18s">
            <a href="/projects" class="btn btn-primary">
              View projects
              <Icon name="arrowRight" class="size-4" />
            </a>
            <a href={site.resume} class="btn btn-ghost" download>
              <Icon name="download" class="size-4" />
              Résumé
            </a>
            <a href="/contact" class="btn btn-ghost">Contact</a>
          </div>
        </div>

        <!-- Spec sheet — reads like a datasheet header, not a hero graphic -->
        <dl
          class="anim-fade-up self-end border-t border-[var(--line)] pt-6 lg:col-span-4 lg:col-start-9 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-2"
          style="animation-delay:.24s"
        >
          {
            [
              { k: 'Focus', v: 'Robotics · Power electronics · UAV' },
              { k: 'Disciplines', v: 'Robotics, Electronics, Microcontrollers' },
              { k: 'Currently', v: 'SUBASS — drone battery swapping' },
              { k: 'Based in', v: site.location },
            ].map((row) => (
              <div class="flex justify-between gap-6 border-b border-[var(--line)] py-3 last:border-b-0 lg:block lg:border-b-0 lg:py-0 lg:pb-5">
                <dt class="label shrink-0">{row.k}</dt>
                <dd class="text-right text-sm text-fg lg:mt-1.5 lg:text-left">{row.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
