---
import Icon from './Icon.astro';
import { timeline, type TimelineKind } from '../data/timeline';

interface Props {
  /** Cap the number of entries — used for the home-page preview */
  limit?: number;
}

const { limit } = Astro.props;
const entries = limit ? timeline.slice(0, limit) : timeline;

const kindLabel: Record<TimelineKind, string> = {
  leadership: 'Leadership',
  project: 'Project',
  internship: 'Internship',
  competition: 'Competition',
  achievement: 'Achievement',
  education: 'Education',
};
---

<ol class="relative">
  <!-- Spine -->
  <span
    class="absolute left-[1.375rem] top-2 bottom-2 w-px bg-gradient-to-b from-cyan-neon/45 via-white/10 to-transparent sm:left-[1.625rem]"
    aria-hidden="true"></span>

  {
    entries.map((entry, i) => (
      <li
        class="group relative pl-16 pb-12 last:pb-0 sm:pl-20"
        data-reveal
        style={`--reveal-delay:${Math.min(i, 5) * 60}ms`}
      >
        {/* Node */}
        <span class="absolute left-0 top-0 grid size-11 place-items-center rounded-xl border border-[var(--line-strong)] bg-ink text-cyan-soft transition-colors duration-500 group-hover:border-cyan-neon/50 sm:size-[3.25rem]">
          <Icon name={entry.kind} class="size-5" />
        </span>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <span class="font-mono text-[0.7rem] tracking-[0.16em] text-cyan-soft">
            {entry.period}
          </span>
          <span class="size-1 rotate-45 bg-white/20" aria-hidden="true" />
          <span class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-fg-faint">
            {kindLabel[entry.kind]}
          </span>
        </div>

        <h3 class="display mt-2.5 text-xl sm:text-2xl">
          {entry.href ? (
            <a
              href={entry.href}
              class="inline-flex items-baseline gap-2 transition-colors hover:text-cyan-soft"
            >
              {entry.title}
              <Icon name="arrowUpRight" class="size-4 shrink-0 opacity-50" />
            </a>
          ) : (
            entry.title
          )}
        </h3>

        {entry.org && (
          <p class="mt-1 text-sm font-medium text-fg-muted">{entry.org}</p>
        )}

        <p class="mt-3 max-w-2xl leading-relaxed text-fg-muted">{entry.detail}</p>

        {entry.points && entry.points.length > 0 && (
          <ul class="mt-4 space-y-2">
            {entry.points.map((point) => (
              <li class="relative max-w-2xl pl-5 text-sm leading-relaxed text-fg-muted">
                <span
                  class="absolute left-0 top-[0.55em] size-1.5 rotate-45 bg-cyan-neon/70"
                  aria-hidden="true"
                />
                {point}
              </li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ol>
