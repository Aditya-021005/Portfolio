---
import Icon from './Icon.astro';

interface Media {
  src: string;
  alt: string;
  caption?: string;
  span: 'normal' | 'wide' | 'tall';
}

interface Props {
  items: Media[];
}

const { items } = Astro.props;

const spanClass: Record<Media['span'], string> = {
  normal: 'sm:col-span-1 aspect-[4/3]',
  wide: 'sm:col-span-2 aspect-[16/9]',
  tall: 'sm:col-span-1 sm:row-span-2 aspect-[3/4] sm:aspect-auto',
};
---

{
  items.length > 0 && (
    <>
      <div class="grid auto-rows-[minmax(0,1fr)] grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((item, i) => (
          <figure
            class:list={[
              'group relative overflow-hidden rounded-[var(--radius-card)] border border-[var(--line)] bg-ink',
              spanClass[item.span],
            ]}
            data-reveal
            style={`--reveal-delay:${Math.min(i, 5) * 55}ms`}
          >
            <button
              type="button"
              class="block size-full cursor-zoom-in"
              data-lightbox={item.src}
              data-lightbox-alt={item.alt}
              data-lightbox-caption={item.caption ?? ''}
              aria-label={`Enlarge: ${item.alt || 'image'}`}
            >
              <img
                src={item.src}
                alt={item.alt}
                loading="lazy"
                decoding="async"
                class="size-full object-cover transition-transform duration-[1.1s] [transition-timing-function:var(--ease-out-expo)] group-hover:scale-[1.06]"
              />
              <span class="pointer-events-none absolute right-3 top-3 grid size-8 place-items-center rounded-lg border border-[var(--line-strong)] bg-void/60 text-fg opacity-0 backdrop-blur-md transition-opacity duration-400 group-hover:opacity-100">
                <Icon name="plus" class="size-4" />
              </span>
            </button>

            {item.caption && (
              <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-void via-void/80 to-transparent p-4 pt-10 text-xs leading-relaxed text-fg-muted opacity-0 transition-opacity duration-500 group-hover:opacity-100">
                {item.caption}
              </figcaption>
            )}
          </figure>
        ))}
      </div>

      {/* Lightbox */}
      <div
        id="lightbox"
        class="pointer-events-none fixed inset-0 z-[80] opacity-0 transition-opacity duration-400"
        role="dialog"
        aria-modal="true"
        aria-label="Image viewer"
        aria-hidden="true"
      >
        <div class="absolute inset-0 bg-void/94 backdrop-blur-xl" data-lightbox-close />
        <div class="relative flex h-full flex-col items-center justify-center gap-5 p-6 sm:p-12">
          <img
            id="lightbox-img"
            src=""
            alt=""
            class="max-h-[78vh] max-w-full rounded-[var(--radius-card)] border border-[var(--line-strong)] object-contain"
          />
          <p id="lightbox-caption" class="max-w-2xl text-center text-sm text-fg-muted" />

          <button
            type="button"
            class="absolute right-5 top-5 grid size-11 place-items-center rounded-xl border border-[var(--line-strong)] bg-white/5 text-fg transition-colors hover:border-cyan-neon/50"
            data-lightbox-close
            aria-label="Close viewer"
          >
            <Icon name="close" class="size-5" />
          </button>

          <button
            type="button"
            id="lightbox-prev"
            class="absolute left-4 top-1/2 grid size-11 -translate-y-1/2 place-items-center rounded-xl border border-[var(--line-strong)] bg-white/5 text-fg transition-colors hover:border-cyan-neon/50"
            aria-label="Previous image"
          >
            <Icon name="arrowLeft" class="size-5" />
          </button>
          <button
            type="button"
            id="lightbox-next"
            class="absolute right-4 top-1/2 grid size-11 -translate-y-1/2 place-items-center rounded-xl border border-[var(--line-strong)] bg-white/5 text-fg transition-colors hover:border-cyan-neon/50"
            aria-label="Next image"
          >
            <Icon name="arrowRight" class="size-5" />
          </button>
        </div>
      </div>

      <script is:inline>
        (() => {
          const box = document.getElementById('lightbox');
          const img = document.getElementById('lightbox-img');
          const cap = document.getElementById('lightbox-caption');
          if (!box || !img || !cap) return;

          const triggers = Array.from(document.querySelectorAll('[data-lightbox]'));
          if (!triggers.length) return;

          let current = 0;
          let lastFocus = null;

          const show = (i) => {
            current = (i + triggers.length) % triggers.length;
            const t = triggers[current];
            img.setAttribute('src', t.dataset.lightbox);
            img.setAttribute('alt', t.dataset.lightboxAlt || '');
            cap.textContent = t.dataset.lightboxCaption || '';
          };

          const open = (i) => {
            lastFocus = document.activeElement;
            show(i);
            box.classList.remove('pointer-events-none', 'opacity-0');
            box.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
          };

          const close = () => {
            box.classList.add('pointer-events-none', 'opacity-0');
            box.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            if (lastFocus && lastFocus.focus) lastFocus.focus();
          };

          triggers.forEach((t, i) => t.addEventListener('click', () => open(i)));
          box.querySelectorAll('[data-lightbox-close]').forEach((el) =>
            el.addEventListener('click', close)
          );
          document.getElementById('lightbox-prev')?.addEventListener('click', () => show(current - 1));
          document.getElementById('lightbox-next')?.addEventListener('click', () => show(current + 1));

          document.addEventListener('keydown', (e) => {
            if (box.getAttribute('aria-hidden') === 'true') return;
            if (e.key === 'Escape') close();
            if (e.key === 'ArrowLeft') show(current - 1);
            if (e.key === 'ArrowRight') show(current + 1);
          });
        })();
      </script>
    </>
  )
}
