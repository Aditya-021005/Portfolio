---
/** Sticky table of contents built from the rendered Markdown headings. */
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  /** Extra anchors appended after the body sections (gallery, videos, …) */
  extra?: { slug: string; text: string }[];
}

const { headings, extra = [] } = Astro.props;
const items = [...headings.filter((h) => h.depth === 2), ...extra.map((e) => ({ depth: 2, ...e }))];
---

{
  items.length > 1 && (
    <nav aria-label="On this page" class="hidden lg:block">
      <div class="sticky top-[calc(var(--nav-h)+2.5rem)]">
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.22em] text-fg-faint">
          On this page
        </p>
        <ul class="mt-5 space-y-1 border-l border-[var(--line)]">
          {items.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                data-toc={h.slug}
                class="-ml-px block border-l border-transparent py-1.5 pl-4 text-sm leading-snug text-fg-faint transition-colors duration-300 hover:text-fg"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}

<script is:inline>
  (() => {
    const links = Array.from(document.querySelectorAll('[data-toc]'));
    if (!links.length || !('IntersectionObserver' in window)) return;

    const byId = new Map(links.map((l) => [l.dataset.toc, l]));
    const targets = links
      .map((l) => document.getElementById(l.dataset.toc))
      .filter(Boolean);

    const setActive = (id) => {
      links.forEach((l) => {
        const on = l.dataset.toc === id;
        l.classList.toggle('text-cyan-soft', on);
        l.classList.toggle('border-cyan-neon', on);
        l.classList.toggle('text-fg-faint', !on);
        l.classList.toggle('border-transparent', !on);
      });
    };

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-20% 0px -65% 0px', threshold: 0 }
    );

    targets.forEach((t) => io.observe(t));
    if (targets[0]) setActive(targets[0].id);
    void byId;
  })();
</script>
