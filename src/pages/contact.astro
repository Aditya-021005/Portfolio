---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, socials } from '../data/site';

const channels = [
  {
    label: 'Email',
    value: site.email,
    href: `mailto:${site.email}`,
    icon: 'mail',
    note: 'Best for roles, PCB work and research collaborations.',
    copy: true,
  },
  {
    label: 'GitHub',
    value: socials.find((s) => s.label === 'GitHub')?.href.replace('https://', '') ?? '',
    href: socials.find((s) => s.label === 'GitHub')?.href ?? '#',
    icon: 'github',
    note: 'Hardware tooling, control code and build scripts.',
  },
  {
    label: 'LinkedIn',
    value: socials.find((s) => s.label === 'LinkedIn')?.href.replace('https://', '') ?? '',
    href: socials.find((s) => s.label === 'LinkedIn')?.href ?? '#',
    icon: 'linkedin',
    note: 'Professional background and experience.',
  },
];

const openTo = [
  'Robotics and UAV platform engineering',
  'PCB design and hardware bring-up',
  'Research in electronics-based robotic systems',
  'Sensor integration',
];
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${site.name} — robotics, power electronics and UAV hardware engineering.`}
>
  <header class="relative overflow-hidden pb-6 pt-2 sm:pt-6">
    <div class="grid-backdrop pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="shell relative">
      <p class="eyebrow anim-fade-up">Contact</p>
      <h1
        class="display anim-fade-up mt-6 max-w-3xl text-[clamp(2.25rem,7vw,4.5rem)]"
        style="animation-delay:.06s"
      >
        Let's build something.
      </h1>
      <p class="lede anim-fade-up mt-7 max-w-xl" style="animation-delay:.12s">
        The fastest way to reach me is email — I read everything and reply to anything concrete.
      </p>
    </div>
  </header>

  <div class="shell pb-24 pt-14">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Channels -->
      <div class="lg:col-span-7">
        <ul class="border-t border-[var(--line)]">
          {
            channels.map((c, i) => (
              <li data-reveal style={`--reveal-delay:${i * 70}ms`}>
                <div class="group relative flex flex-wrap items-center gap-x-5 gap-y-3 border-b border-[var(--line)] py-6 transition-colors duration-500 hover:border-[var(--line-strong)]">
                  <span class="grid size-10 shrink-0 place-items-center rounded border border-[var(--line)] text-fg-muted transition-colors duration-500 group-hover:border-cyan-neon/50 group-hover:text-cyan-soft">
                    <Icon name={c.icon} class="size-4" />
                  </span>

                  <div class="min-w-0 flex-1">
                    <p class="label">{c.label}</p>
                    <a
                      href={c.href}
                      target={c.href.startsWith('http') ? '_blank' : undefined}
                      rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                      class="mt-1.5 block truncate text-base text-fg transition-colors hover:text-cyan-soft sm:text-lg"
                    >
                      {c.value}
                    </a>
                    <p class="mt-1.5 text-sm text-fg-muted">{c.note}</p>
                  </div>

                  {c.copy && (
                    <button
                      type="button"
                      class="btn btn-ghost shrink-0 !px-4 !py-2 text-[0.8rem]"
                      data-copy={c.value}
                    >
                      <Icon name="copy" class="size-3.5" />
                      <span data-copy-label>Copy</span>
                    </button>
                  )}
                </div>
              </li>
            ))
          }
        </ul>

        <div class="mt-10 flex flex-wrap gap-3" data-reveal>
          <a href={`mailto:${site.email}`} class="btn btn-primary">
            <Icon name="mail" class="size-4" />
            Write to me
          </a>
          <a href={site.resume} class="btn btn-ghost" download>
            <Icon name="download" class="size-4" />
            Download résumé
          </a>
        </div>
      </div>

      <!-- Aside -->
      <aside class="lg:col-span-5">
        <div class="glass rounded-[var(--radius-card)] p-7" data-reveal>
          <p class="eyebrow">Open to</p>
          <ul class="mt-6 space-y-3.5">
            {
              openTo.map((item) => (
                <li class="flex gap-3 text-sm leading-relaxed text-fg-muted">
                  <Icon name="check" class="mt-0.5 size-4 shrink-0 text-cyan-neon" />
                  {item}
                </li>
              ))
            }
          </ul>

          <div class="mt-8 space-y-4 border-t border-[var(--line)] pt-6">
            <div class="flex items-baseline justify-between gap-4">
              <span class="label">Location</span>
              <span class="text-sm text-fg">{site.location}</span>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <span class="label">Response time</span>
              <span class="text-sm text-fg">Usually within 48h</span>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <span class="label">Status</span>
              <span class="inline-flex items-center gap-2 text-sm text-fg">
                <span class="size-1.5 rounded-full bg-cyan-neon"></span>
                Available
              </span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
        if (label) {
          const original = label.textContent;
          label.textContent = 'Copied';
          setTimeout(() => {
            label.textContent = original;
          }, 1800);
        }
      } catch {
        window.location.href = `mailto:${btn.dataset.copy}`;
      }
    });
  });
</script>
