---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, categoriesOf } from '../../lib/projects';

const projects = await getProjects();
const categories = categoriesOf(projects);

const countOf = (category: string) => {
  if (category === 'all') return projects.length;
  return projects.filter((p) => p.data.category === category).length;
};
---

<BaseLayout
  title="Projects"
  description="Embedded systems, robotics, UAV, PCB design and computer-vision projects — full build write-ups."
>
  <!-- Header -->
  <header class="relative overflow-hidden pb-4 pt-2 sm:pt-6">
    <div class="grid-backdrop pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="shell relative">
      <p class="eyebrow anim-fade-up">Work — {projects.length} projects</p>
      <h1 class="display anim-fade-up mt-5 text-[clamp(2.5rem,7vw,4.5rem)]" style="animation-delay:.08s">
        Every build,<br /><span class="text-gradient">documented properly.</span>
      </h1>
      <p
        class="anim-fade-up mt-6 max-w-2xl text-lg leading-relaxed text-fg-muted"
        style="animation-delay:.16s"
      >
        Problem statement, design process, hardware, control, what broke, and what the next
        revision fixed. Filter by discipline below.
      </p>
    </div>
  </header>

  <!-- Filter bar -->
  <div class="sticky z-30 py-2 sm:py-3 transition-all duration-500 pointer-events-none" style="top:calc(var(--nav-h) + 0.25rem)">
    <div class="shell flex justify-center px-2 sm:px-4">
      <div
        id="project-filters"
        class="project-filters pointer-events-auto flex flex-wrap sm:flex-nowrap items-center justify-center gap-1 sm:gap-1.5 rounded-2xl sm:rounded-full border border-white/12 bg-[#0c0e11]/92 p-1.5 sm:p-1.5 shadow-[0_12px_36px_rgba(0,0,0,0.55),inset_0_1px_0_rgba(255,255,255,0.12)] backdrop-blur-xl transition-all duration-400 ease-[cubic-bezier(0.22,1,0.36,1)]"
        role="tablist"
        aria-label="Filter projects by category"
      >
        <button
          type="button"
          class="filter-btn rounded-full px-2.5 sm:px-4 py-1 sm:py-2 font-mono text-[0.62rem] sm:text-[0.72rem] uppercase tracking-[0.1em] transition-all duration-300 flex items-center gap-1.5"
          data-filter="all"
          role="tab"
          aria-selected="true"
        >
          <span class="filter-dot size-1.5 rounded-full bg-cyan-neon hidden shadow-[0_0_6px_var(--color-cyan-neon)]"></span>
          <span>All</span>
          <span class="count-badge font-mono text-[0.58rem] sm:text-[0.62rem] opacity-60">({countOf('all')})</span>
        </button>
        {
          categories.map((cat) => (
            <button
              type="button"
              class="filter-btn rounded-full px-2.5 sm:px-4 py-1 sm:py-2 font-mono text-[0.62rem] sm:text-[0.72rem] uppercase tracking-[0.1em] transition-all duration-300 flex items-center gap-1.5"
              data-filter={cat}
              role="tab"
              aria-selected="false"
            >
              <span class="filter-dot size-1.5 rounded-full bg-cyan-neon hidden shadow-[0_0_6px_var(--color-cyan-neon)]"></span>
              <span>{cat}</span>
              <span class="count-badge font-mono text-[0.58rem] sm:text-[0.62rem] opacity-60">({countOf(cat)})</span>
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Grid -->
  <div class="shell pb-24 pt-8">
    <div id="project-grid" class="grid gap-x-8 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>

    <p id="empty-state" class="hidden py-24 text-center text-fg-muted">
      No projects in this category yet.
    </p>
  </div>
</BaseLayout>

<style>
  .project-filters {
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    overflow: visible;
  }

  .project-filters--scrolled {
    border-color: rgba(255, 255, 255, 0.18);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.7), 0 0 24px rgba(55, 200, 216, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.16);
    transform: scale(0.985);
  }

  .filter-btn {
    color: var(--color-fg-muted);
    border: 1px solid transparent;
    white-space: nowrap;
  }
  .filter-btn:hover {
    color: var(--color-fg);
    background: rgba(255, 255, 255, 0.05);
  }
  .filter-btn[aria-selected='true'] {
    background: color-mix(in oklab, var(--color-cyan-neon) 15%, transparent);
    color: var(--color-cyan-soft);
    border-color: color-mix(in oklab, var(--color-cyan-neon) 35%, transparent);
    box-shadow: 0 0 14px rgba(55, 200, 216, 0.18);
  }
  .filter-btn[aria-selected='true'] .filter-dot {
    display: inline-block;
  }
  .filter-btn[aria-selected='true'] .count-badge {
    color: var(--color-cyan-soft);
    opacity: 0.9;
  }
</style>

<script is:inline>
  (() => {
    const initFilters = () => {
      const buttons = Array.from(document.querySelectorAll('.filter-btn'));
      const cards = Array.from(document.querySelectorAll('#project-grid [data-category]'));
      const empty = document.getElementById('empty-state');
      const filters = document.getElementById('project-filters');
      if (!buttons.length || !cards.length) return;

      const apply = (filter) => {
        let shown = 0;
        cards.forEach((card) => {
          const match = filter === 'all' || card.dataset.category === filter;
          card.classList.toggle('hidden', !match);
          if (match) shown++;
        });
        empty?.classList.toggle('hidden', shown > 0);

        const url = new URL(window.location.href);
        if (filter === 'all') url.searchParams.delete('category');
        else url.searchParams.set('category', filter);
        history.replaceState(null, '', url);
      };

      const updateCompactState = () => {
        if (!filters) return;
        filters.classList.toggle('project-filters--scrolled', window.scrollY > 48);
      };

      const select = (filter, shouldScroll = true) => {
        buttons.forEach((b) => {
          const isSelected = b.dataset.filter === filter;
          b.setAttribute('aria-selected', String(isSelected));
          if (isSelected && shouldScroll) {
            b.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
          }
        });
        apply(filter);
      };

      buttons.forEach((b) => b.addEventListener('click', () => select(b.dataset.filter, true)));
      updateCompactState();
      window.removeEventListener('scroll', updateCompactState);
      window.addEventListener('scroll', updateCompactState, { passive: true });

      const initial = new URL(window.location.href).searchParams.get('category');
      if (initial && buttons.some((b) => b.dataset.filter === initial)) select(initial, false);
    };

    initFilters();
    document.addEventListener('astro:page-load', initFilters);
  })();
</script>
