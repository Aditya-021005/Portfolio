---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SkillGrid from '../components/SkillGrid.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const principles = [
  {
    icon: 'layers',
    title: 'Systems architecture & cross-domain integration',
    body: 'Rather than working in isolation, I focus on systems-level coordination — making sure PCB layout, power distribution, mechanical enclosures and high-level control fit together cleanly across team domains.',
  },
  {
    icon: 'wrench',
    title: 'Iterate in hardware',
    body: 'Simulation gets you to a starting point. Three console revisions and a rebuilt drivetrain got me to something that actually survives being carried around.',
  },
  {
    icon: 'target',
    title: 'Design for the failure case',
    body: 'Failsafes, brownout behaviour, thermal headroom and battery margin are specified before the fun parts. A UAV that lands itself beats one that flies beautifully until it doesn’t.',
  },
  {
    icon: 'book',
    title: 'Document as you build',
    body: 'Every board I lead gets a schematic review, a test record and a written handover. Teams move faster when the next person doesn’t have to reverse-engineer your reasoning.',
  },
];

const enjoy = [
  'Bring-up day — first power-on of a board I laid out',
  'Debugging an inverter stage until the waveform is what the datasheet promised',
  'Tuning a control loop until the platform stops fighting itself',
  'Squeezing a battery, a display and a haptics driver into a smaller shell',
  'Getting a sensor to report something I actually trust',
  'Explaining to a junior why a ground plane matters',
];

const interests = [
  'Field-Oriented Control and 3-phase motor drive',
  'Autonomous navigation and sensor fusion',
  'High-current power distribution and BMS architecture',
  'Persistent UAV operations and automated ground infrastructure',
  'Digital image processing for field data',
  'Mechanical–electrical integration on compact hardware',
];
---

<BaseLayout
  title="About"
  description="Robotics and Hardware Systems Engineer working across power electronics, motor control, sensor integration, PCB design and mechanical integration."
>
  <!-- ==================== INTRO ==================== -->
  <header class="relative overflow-hidden pb-8 pt-2 sm:pt-6">
    <div class="grid-backdrop pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="shell relative">
      <p class="eyebrow anim-fade-up">About</p>
      <h1
        class="display anim-fade-up mt-5 max-w-4xl text-[clamp(2.25rem,6.5vw,4.25rem)]"
        style="animation-delay:.08s"
      >
        Engineering integrated hardware and
        <span class="text-gradient">robotic systems.</span>
      </h1>

      <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-16">
        <div class="anim-fade-up space-y-5 text-lg leading-relaxed text-fg-muted" style="animation-delay:.16s">
          <p>
            I'm <strong class="text-fg">{site.name}</strong>, a Robotics and Hardware Systems
            Engineer. I develop integrated electronics, power systems and physical hardware for
            autonomous robotic applications — motor control, sensor integration, PCB design and the
            mechanical work that holds it together.
          </p>
          <p>
            Most of what I do sits at the boundaries: between a power stage and the control
            algorithm driving it, between a board and the enclosure it has to fit, between what a
            sensor reports and what is actually true. Those boundaries are where systems fail, and
            they're the part I find worth doing well.
          </p>
          <p>
            My goal is to build robotic platforms that work outside a lab — reliable enough that
            the interesting problem becomes the mission, not the hardware.
          </p>
        </div>

        <aside class="glass anim-fade-up rounded-[var(--radius-card)] p-7" style="animation-delay:.24s">
          <p class="font-mono text-[0.62rem] uppercase tracking-[0.22em] text-fg-faint">
            Currently
          </p>
          <ul class="mt-5 space-y-4">
            <li class="flex gap-3">
              <Icon name="layers" class="mt-0.5 size-4 shrink-0 text-cyan-soft" />
              <span class="text-sm leading-relaxed text-fg-muted">
                <strong class="font-medium text-fg">SUBASS</strong> — an automated drone battery
                swapping system for persistent UAV operations
              </span>
            </li>
            <li class="flex gap-3">
              <Icon name="robot" class="mt-0.5 size-4 shrink-0 text-cyan-soft" />
              <span class="text-sm leading-relaxed text-fg-muted">
                Senior Technical Advisor at CRISS Robotics
              </span>
            </li>
            <li class="flex gap-3">
              <Icon name="bolt" class="mt-0.5 size-4 shrink-0 text-cyan-soft" />
              <span class="text-sm leading-relaxed text-fg-muted">
                Advisor at the Renewable Energy Club
              </span>
            </li>
          </ul>

          <div class="mt-7 flex flex-col gap-3 border-t border-[var(--line)] pt-6 sm:flex-row">
            <a href={site.resume} class="btn btn-primary !px-5 !py-2.5 text-[0.8rem]" download>
              <Icon name="download" class="size-4" />
              Résumé
            </a>
            <a href="/contact" class="btn btn-ghost !px-5 !py-2.5 text-[0.8rem]">
              <Icon name="mail" class="size-4" />
              Contact
            </a>
          </div>
        </aside>
      </div>
    </div>
  </header>

  <!-- ==================== PHILOSOPHY ==================== -->
  <Section
    id="philosophy"
    eyebrow="Engineering philosophy"
    title="How I approach a build."
    lead="My projects are driven by an iterative mindset: prototype rapidly, test honestly, learn from the failures and refine through successive revisions."
  >
    <div class="grid gap-4 sm:grid-cols-2">
      {
        principles.map((p, i) => (
          <article
            class="glass glass-hover rounded-[var(--radius-card)] p-7"
            data-reveal
            style={`--reveal-delay:${i * 70}ms`}
          >
            <span class="grid size-11 place-items-center rounded-xl border border-[var(--line-strong)] bg-white/4 text-cyan-soft">
              <Icon name={p.icon} class="size-5" />
            </span>
            <h3 class="display mt-5 text-lg">{p.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-fg-muted">{p.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ==================== ENJOY / INTERESTS ==================== -->
  <Section class="border-t border-[var(--line)]">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <p class="eyebrow">What I enjoy building</p>
        <h2 class="display mt-4 text-2xl sm:text-3xl">The parts I'd do for free.</h2>
        <ul class="mt-8 space-y-4">
          {
            enjoy.map((item) => (
              <li class="flex gap-3.5 text-fg-muted">
                <Icon name="check" class="mt-1 size-4 shrink-0 text-cyan-neon" />
                <span class="leading-relaxed">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal style="--reveal-delay:90ms">
        <p class="eyebrow">Technical interests</p>
        <h2 class="display mt-4 text-2xl sm:text-3xl">Where I'm pushing next.</h2>
        <ul class="mt-8 space-y-4">
          {
            interests.map((item) => (
              <li class="flex gap-3.5 text-fg-muted">
                <Icon name="arrowRight" class="mt-1 size-4 shrink-0 text-cyan-neon" />
                <span class="leading-relaxed">{item}</span>
              </li>
            ))
          }
        </ul>

        <div class="glass mt-10 rounded-[var(--radius-card)] p-7">
          <p class="eyebrow">Career goal</p>
          <p class="mt-4 leading-relaxed text-fg-muted">
            To build robotic hardware on a team shipping at volume, where the gap between a working
            prototype and a reliable product is the interesting engineering problem.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- ==================== SKILLS ==================== -->
  <Section
    id="skills"
    eyebrow="Capabilities"
    title="Technical skills."
    lead="Grouped by domain. Expand any card for the specific tools, parts and techniques."
    class="border-t border-[var(--line)]"
  >
    <SkillGrid />
  </Section>

  <!-- ==================== ROLES ==================== -->
  <Section
    id="roles"
    eyebrow="Current roles"
    title="Advisory positions."
    class="border-t border-[var(--line)]"
  >
    <div class="grid gap-4 lg:grid-cols-2">
      <article class="glass rounded-[var(--radius-card)] p-8" data-reveal>
        <span class="grid size-11 place-items-center rounded-xl border border-[var(--line-strong)] bg-white/4 text-cyan-soft">
          <Icon name="leadership" class="size-5" />
        </span>
        <h3 class="display mt-5 text-xl">Senior Technical Advisor</h3>
        <p class="mt-1.5 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-cyan-soft">
          CRISS Robotics
        </p>
        <p class="mt-4 leading-relaxed text-fg-muted">
          Advising on the electrical architecture of a multidisciplinary rover programme — battery
          systems, power distribution, PCB review and the integration decisions that determine
          whether the subsystems meet cleanly.
        </p>
        <a
          href="/projects/criss-rover"
          class="mt-6 inline-flex items-center gap-2 text-sm text-cyan-soft transition-colors hover:text-cyan-neon"
        >
          Read the project
          <Icon name="arrowRight" class="size-4" />
        </a>
      </article>

      <article class="glass rounded-[var(--radius-card)] p-8" data-reveal style="--reveal-delay:80ms">
        <span class="grid size-11 place-items-center rounded-xl border border-[var(--line-strong)] bg-white/4 text-cyan-soft">
          <Icon name="bolt" class="size-5" />
        </span>
        <h3 class="display mt-5 text-xl">Advisor</h3>
        <p class="mt-1.5 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-cyan-soft">
          Renewable Energy Club
        </p>
        <p class="mt-4 leading-relaxed text-fg-muted">
          Supporting technical workshops, student build teams and sustainable engineering
          initiatives across campus.
        </p>
      </article>
    </div>
  </Section>
</BaseLayout>
